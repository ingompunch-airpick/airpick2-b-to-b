rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────────────────
    // 정본: airpick2-b-to-b/firestore.rules (+ docs/FIRESTORE_RULES_CANONICAL.md)
    // B2C는 이 파일을 동기화만 하고, rules 배포는 B2B에서만 한다

    function isSignedIn() {
      return request.auth != null;
    }

    /** B2B 본사 Firebase Auth 계정 (Anonymous 아님). 예약 삭제 등 Rules 경로용 */
    function isPlatformAdmin() {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email in [
          'drive5746@gmail.com',
          'ingompunch@gmail.com'
        ];
    }

    /** 파트너 커스텀 토큰 — verifyPartnerLogin 발급 claim */
    function partnerCompanyId() {
      return isSignedIn()
        && request.auth.token.partnerCompanyId is string
        && request.auth.token.partnerCompanyId.size() > 0
        ? request.auth.token.partnerCompanyId
        : '';
    }

    function isPartner() {
      return partnerCompanyId().size() > 0;
    }

    /** 와와 별칭 문서 companyId 합산 */
    function isWawaCompanyId(cid) {
      return cid in ['wawa', 'wawa_valet', '와와', '와와발렛'];
    }

    /** parentCompanyId 가 대표 업체인 하위 브랜드(가유→hi·season 등) */
    function isChildOfPartnerCompany(cid) {
      return isValidCompanyId(cid)
        && exists(/databases/$(database)/documents/companies/$(cid))
        && get(/databases/$(database)/documents/companies/$(cid)).data.parentCompanyId is string
        && get(/databases/$(database)/documents/companies/$(cid)).data.parentCompanyId == partnerCompanyId();
    }

    function partnerCanAccessCompany(cid) {
      return isPartner()
        && (
          partnerCompanyId() == cid
          || (isWawaCompanyId(partnerCompanyId()) && isWawaCompanyId(cid))
          || isChildOfPartnerCompany(cid)
        );
    }

    function isValidCompanyId(companyId) {
      return companyId.matches('^[a-z0-9_]{1,64}$');
    }

    /**
     * 가맹점(클라이언트)이 바꿀 수 있는 운영 필드만.
     * 생성·삭제·프로필(핀·보험·비밀번호·status 등)은 Cloud Functions Admin SDK만.
     */
    function onlyPartnerOperationalFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'id',
        'base_price',
        'extra_day_price',
        'base_days',
        'outdoorBasePrice',
        'outdoorBaseDays',
        'outdoorExtraPrice',
        'indoorBasePrice',
        'indoorBaseDays',
        'indoorExtraPrice',
        'surchargeStartTime',
        'surchargeEndTime',
        'surchargePrice',
        't2Surcharge',
        'peakStartTime',
        'peakEndTime',
        'peakSurcharge',
        'valetFeeT1',
        'valetFeeT2',
        // employees 는 upsertCompanyEmployees (Admin SDK) 만
        'pickupLocation',
        'isOpen',
        'blockedDates',
        'blockedDatesIndoor',
        'blockedDatesOutdoor',
        'cancelCutoffHours',
        'sameDayBookingBlocked',
        'bookingLeadHours',
        'hourlyCapEnabled',
        'maxCarsPerHour',
        'parkingCapEnabled',
        'maxParkedCars',
        'maxParkedCarsIndoor',
        'maxParkedCarsOutdoor',
        'dailyIntakeCapEnabled',
        'maxCarsPerDay',
        'scheduleBlocks',
        'phone',
        'updatedAt'
      ]);
    }

    function bookingSettingsShapeValid() {
      let data = request.resource.data;
      return (!('bookingLeadHours' in data)
          || (data.bookingLeadHours is int && data.bookingLeadHours >= 0 && data.bookingLeadHours <= 24))
        && (!('dailyIntakeCapEnabled' in data) || data.dailyIntakeCapEnabled is bool)
        && (!('maxCarsPerDay' in data)
          || (data.maxCarsPerDay is int && data.maxCarsPerDay >= 0 && data.maxCarsPerDay <= 999))
        && (!('scheduleBlocks' in data)
          || (data.scheduleBlocks is list && data.scheduleBlocks.size() <= 200));
    }

    function isValidReservationId(reservationId) {
      return reservationId.matches('^[a-zA-Z0-9_-]{1,128}$');
    }

    function reservationCoreFieldsValid(data) {
      return data.keys().hasAll(['status', 'createdAt'])
        && data.status is string
        && data.status.size() > 0
        && data.status.size() <= 64
        && data.createdAt is string
        && data.createdAt.size() > 0
        && data.createdAt.size() <= 40;
    }

    function reservationCompanyIdValid(data) {
      return !('companyId' in data)
        || (data.companyId is string
            && data.companyId.size() > 0
            && data.companyId.size() <= 64);
    }

    function reservationTotalPriceValid(data) {
      return !('totalPrice' in data)
        || (data.totalPrice is number && data.totalPrice >= 0);
    }

    function validReservationWrite() {
      return reservationCoreFieldsValid(request.resource.data)
        && reservationCompanyIdValid(request.resource.data)
        && reservationTotalPriceValid(request.resource.data);
    }

    /**
     * 보안·생성 필드는 최초 생성 후 클라이언트가 변경할 수 없다.
     * 취소·비번 검증 등 정당한 변경은 Cloud Functions(admin)가 규칙을 우회해 처리.
     */
    function reservationProtectedFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny([
          'reservationPassword',
          'receiptToken',
          'createdBy',
          'createdAt',
          'userId',
          'memberProvider',
          'userIdLocked',
          'acquisitionSource',
          'acquisitionMedium',
          'acquisitionCampaign',
          'acquisitionClickId',
          'affiliateCode',
          'affiliateCustomerDiscountWon',
          'affiliateReferrerCreditWon',
          'pointSpendWon',
          'pointSpentWon',
          'pointsEarnedWon',
          'pointRefunded',
          'pointSpendSettled',
        ]);
    }

    function canListReservation() {
      return isPlatformAdmin()
        || (
          isPartner()
          && resource.data.companyId is string
          && partnerCanAccessCompany(resource.data.companyId)
        );
    }

    /** 단건 get — B2C MY·영수증(문서 ID)·접수 직후. 비밀번호는 secrets. list 는 막음. */
    function canGetReservation() {
      return isSignedIn();
    }

    // ── reservations ───────────────────────────────────────────────────────

    match /reservations/{reservationId} {
      // list: 본사 전체 · 파트너는 자기 업체(와와 별칭 포함)만
      // get: 로그인 세션(손님 단건·영수증). 목록 훑기는 list 로 막음
      allow get: if canGetReservation();
      allow list: if canListReservation();

      allow create: if isSignedIn()
        && isValidReservationId(reservationId)
        && validReservationWrite();

      // 파트너는 자기 업체만 수정. 손님 클라이언트 수정은 CF(취소 등)로 이전됨.
      allow update: if isSignedIn()
        && isValidReservationId(reservationId)
        && validReservationWrite()
        && reservationProtectedFieldsUnchanged()
        && (
          isPlatformAdmin()
          || (
            isPartner()
            && resource.data.companyId is string
            && partnerCanAccessCompany(resource.data.companyId)
            && request.resource.data.companyId == resource.data.companyId
          )
        );

      // 고객·파트너는 상태 변경으로 취소. 문서 삭제는 본사만.
      allow delete: if isPlatformAdmin() && isValidReservationId(reservationId);

      // 예약 조회·취소·후기 인증용 4자리 비밀번호 — Admin SDK(Functions)만
      match /secrets/{secretId} {
        allow read, write: if false;
      }
    }

    match /storage_retention/{reservationId} {
      allow read, write: if false;
    }

    // ── capacity (시간당 입고 집계 — 대수만) ───────────────────────────────
    // 손님 화면이 마감 확인용으로 읽는다. 갱신은 onReservationSync(Admin SDK)만.

    match /capacity/{capacityId} {
      allow read: if true;
      allow write: if false;
    }

    // 날짜별 실내/야외 주차 대수. 손님·직원이 예약 목록 대신 읽는다.
    match /parkingOccupancy/{companyId} {
      allow read: if true;
      allow write: if false;
    }

    // 홈에 보여줄 후기 건수·평균·최근 6건. 개인 연락처는 넣지 않는다.
    match /reviewSummaries/{companyId} {
      allow read: if true;
      allow write: if false;
    }

    // ── acquisitionClicks (명함 QR 등 영업 유입) ───────────────────────────
    // 목록(성과)은 본사만. get/create/update 는 손님 /h/ 추적에 필요.

    match /acquisitionClicks/{clickId} {
      allow get: if isSignedIn();
      allow list: if isPlatformAdmin();

      allow create: if isSignedIn()
        && clickId.matches('acq_[a-zA-Z0-9]{8,40}')
        && request.resource.data.keys().hasAll([
          'companyId', 'source', 'medium', 'campaign', 'clickedAt'
        ])
        && request.resource.data.companyId is string
        && request.resource.data.companyId.size() > 0
        && request.resource.data.companyId.size() < 64
        && request.resource.data.source is string
        && request.resource.data.medium is string
        && request.resource.data.campaign is string
        && request.resource.data.clickedAt is string
        && !('phone' in request.resource.data)
        && !('userName' in request.resource.data)
        && !('carNumber' in request.resource.data);

      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['landedAt', 'convertedReservationId', 'convertedAt'])
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.source == resource.data.source
        && request.resource.data.medium == resource.data.medium
        && request.resource.data.campaign == resource.data.campaign
        && request.resource.data.clickedAt == resource.data.clickedAt
        && (
          !('convertedReservationId' in resource.data)
          || resource.data.convertedReservationId == null
          || request.resource.data.convertedReservationId == resource.data.convertedReservationId
        );

      allow delete: if false;
    }

    // ── affiliates (B2C 추천·제휴) ─────────────────────────────────────────
    // 문서 ID = 코드. 목록·쓰기는 본사만.
    // 단건 get 은 비로그인 B2C도 허용 — 비교·예약 화면에서 할인액 조회.

    match /affiliates/{affiliateId} {
      allow get: if affiliateId.matches('^[a-z0-9_]{3,16}$');
      allow list: if isPlatformAdmin();
      allow create, update: if isPlatformAdmin()
        && affiliateId.matches('^[a-z0-9_]{3,16}$')
        && request.resource.data.keys().hasAll([
          'code', 'name', 'status', 'createdAt', 'updatedAt',
          'marketingBudgetWon', 'customerDiscountWon', 'referrerCreditWon'
        ])
        && request.resource.data.code == affiliateId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.status in ['active', 'suspended']
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && request.resource.data.marketingBudgetWon is number
        && request.resource.data.marketingBudgetWon >= 0
        && request.resource.data.marketingBudgetWon <= 1000000
        && request.resource.data.customerDiscountWon is number
        && request.resource.data.customerDiscountWon >= 0
        && request.resource.data.customerDiscountWon <= 1000000
        && request.resource.data.referrerCreditWon is number
        && request.resource.data.referrerCreditWon >= 0
        && request.resource.data.referrerCreditWon <= 1000000
        && request.resource.data.customerDiscountWon + request.resource.data.referrerCreditWon
          <= request.resource.data.marketingBudgetWon;
      allow delete: if isPlatformAdmin()
        && affiliateId.matches('^[a-z0-9_]{3,16}$');
    }

    // 제휴 실적 포털 비밀번호 — 공개 affiliates get 과 분리. 본사만 클라이언트 읽기/쓰기.
    match /affiliateSecrets/{affiliateId} {
      allow get: if isPlatformAdmin()
        && affiliateId.matches('^[a-z0-9_]{3,16}$');
      allow list: if false;
      allow create, update: if isPlatformAdmin()
        && affiliateId.matches('^[a-z0-9_]{3,16}$')
        && request.resource.data.keys().hasAll(['password', 'updatedAt'])
        && request.resource.data.password is string
        && request.resource.data.password.size() >= 4
        && request.resource.data.password.size() <= 64
        && request.resource.data.updatedAt is string
        && (
          !('statsToken' in request.resource.data)
          || (
            request.resource.data.statsToken is string
            && request.resource.data.statsToken.size() >= 16
            && request.resource.data.statsToken.size() <= 64
          )
        );
      allow delete: if isPlatformAdmin()
        && affiliateId.matches('^[a-z0-9_]{3,16}$');
    }

    // ── customers (방문 횟수 — 전화 숫자 키) ───────────────────────────────

    match /customers/{phoneKey} {
      allow read: if isPlatformAdmin() || isPartner();
      allow create, update, delete: if false;
    }

    // ── companies ──────────────────────────────────────────────────────────

    match /companies/{companyId} {
      allow read: if true;

      // 생성·삭제는 Cloud Functions(adminUpsertCompany / adminDeleteCompany)만
      allow create, delete: if false;

      // 본사 전체 · 파트너는 자기 업체 운영 필드만
      allow update: if isValidCompanyId(companyId)
        && onlyPartnerOperationalFieldsChanged()
        && bookingSettingsShapeValid()
        && (
          isPlatformAdmin()
          || partnerCanAccessCompany(companyId)
        );

      // 로그인 비밀번호 — Admin SDK만
      match /secrets/{secretId} {
        allow read, write: if false;
      }
    }

    // ── system_settings / parking_lots ─────────────────────────────────────

    match /system_settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /parking_lots/{lotId} {
      allow read: if true;
      allow write: if false;
    }

    // ── reviews (후기 — 쓰기는 Cloud Functions만) ─────────────────────────

    match /reviews/{reviewId} {
      allow read: if isSignedIn() && resource.data.status == 'published';
      allow create, update, delete: if false;
    }

    // ── partnerHomepageStats (파트너 홈 일별 조회수) ─────────────────────
    // 공개 페이지에서 increment. 목록/조회는 본사 Admin만.
    match /partnerHomepageStats/{companyId}/days/{dayId} {
      allow read: if isPlatformAdmin();
      allow create, update: if isValidCompanyId(companyId)
        && dayId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['pageViews', 'updatedAt', 'sources'])
        && (
          !('sources' in request.resource.data)
          || (request.resource.data.sources is map && request.resource.data.sources.size() <= 40)
        )
        && request.resource.data.pageViews is int
        && request.resource.data.pageViews > 0
        && request.resource.data.pageViews < 100000000
        && request.resource.data.updatedAt is string
        && (
          !exists(/databases/$(database)/documents/partnerHomepageStats/$(companyId)/days/$(dayId))
          || request.resource.data.pageViews >= resource.data.pageViews
        );
      allow delete: if false;
    }

    // ── hqCustomerHistory (앱에서 지운 출차 완료 수, 전화번호별) ──────────
    match /hqCustomerHistory/{docId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    // ── hqMonthSnapshots (본사 월간 합계, 지난달만) ───────────────────────
    match /hqMonthSnapshots/{monthId} {
      allow read: if isPlatformAdmin() && monthId.matches('^[0-9]{4}-[0-9]{2}$');
      allow create, update, delete: if false;
    }

    // 업체별 지난달 매출. 다른 업체 숫자는 보이지 않는다.
    match /companyMonthSnapshots/{companyId}/months/{monthId} {
      allow read: if monthId.matches('^[0-9]{4}-[0-9]{2}$')
        && (isPlatformAdmin() || partnerCanAccessCompany(companyId));
      allow create, update, delete: if false;
    }

    // ── appConfig (본사 설정) ────────────────────────────────────────────
    match /appConfig/{configId} {
      allow get: if isSignedIn();
      allow list: if isPlatformAdmin();
      allow create, update: if isPlatformAdmin()
        && configId == 'reservationAlerts'
        && request.resource.data.titleAirpick is string
        && request.resource.data.titleAirpick.size() > 0
        && request.resource.data.titleAirpick.size() <= 24
        && request.resource.data.titleOther is string
        && request.resource.data.titleOther.size() > 0
        && request.resource.data.titleOther.size() <= 24;
      allow delete: if false;
    }

    // ── FCM 디바이스 토큰 (파트너 앱 푸시) ───────────────────────────────
    match /fcmTokens/{tokenId} {
      allow read: if false;
      allow create, update: if isSignedIn()
        && request.resource.data.token is string
        && request.resource.data.token.size() > 10
        && request.resource.data.companyId is string
        && request.resource.data.companyId.size() > 0
        && request.resource.data.scopeCompanyIds is list
        && request.resource.data.enabled is bool
        && (
          isPlatformAdmin()
          || partnerCanAccessCompany(request.resource.data.companyId)
        );
      allow delete: if isSignedIn()
        && (
          isPlatformAdmin()
          || (
            resource.data.companyId is string
            && partnerCanAccessCompany(resource.data.companyId)
          )
        );
    }

    // ── members (카카오 로그인 회원. 문서 ID = Firebase uid) ─────────────
    // B2C 내 예약 저장. 배포는 이 저장소에서만 한다.

    function kakaoMemberWriteValid(uid) {
      let data = request.resource.data;
      return isSignedIn()
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'oidc.kakao'
        && data.uid == uid
        && data.provider == 'kakao'
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 40
        && data.phone is string
        && data.phone.size() >= 10
        && data.phone.size() <= 20
        && data.carNumber is string
        && data.carNumber.size() <= 20
        && (!('carModel' in data) || (data.carModel is string && data.carModel.size() <= 40))
        && data.reservationIds is list
        && data.reservationIds.size() <= 20
        && (!('guestPhoneClaimed' in data) || (data.guestPhoneClaimed is string && data.guestPhoneClaimed.size() <= 11))
        && (!('guestPhoneClaimedAt' in data) || (data.guestPhoneClaimedAt is string && data.guestPhoneClaimedAt.size() <= 40))
        && (!('marketingOptIn' in data) || data.marketingOptIn is bool)
        && data.createdAt is string
        && data.createdAt.size() > 0
        && data.createdAt.size() <= 40
        && data.updatedAt is string
        && data.updatedAt.size() > 0
        && data.updatedAt.size() <= 40;
    }

    function memberClaimFieldsUnchanged() {
      return request.resource.data.reservationIds == resource.data.reservationIds
        && (
          !('guestPhoneClaimed' in resource.data)
            ? !('guestPhoneClaimed' in request.resource.data)
            : request.resource.data.guestPhoneClaimed == resource.data.guestPhoneClaimed
        )
        && (
          !('guestPhoneClaimedAt' in resource.data)
            ? !('guestPhoneClaimedAt' in request.resource.data)
            : request.resource.data.guestPhoneClaimedAt == resource.data.guestPhoneClaimedAt
        );
    }

    match /members/{uid} {
      allow read: if (isSignedIn() && request.auth.uid == uid) || isPlatformAdmin();
      // 예약 번호와 전화번호 결합 잠금은 Functions만 쓴다. 가입 때는 빈 목록으로 만든다.
      allow create: if kakaoMemberWriteValid(uid)
        && request.resource.data.reservationIds.size() == 0
        && !('guestPhoneClaimed' in request.resource.data)
        && !('guestPhoneClaimedAt' in request.resource.data);
      allow update: if kakaoMemberWriteValid(uid)
        && request.resource.data.createdAt == resource.data.createdAt
        && memberClaimFieldsUnchanged();
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // 포인트 잔액 — 손님은 자기 잔액만 읽고, 적립·사용은 Functions만 쓴다.
    match /pointAccounts/{uid} {
      allow read: if (isSignedIn() && request.auth.uid == uid) || isPlatformAdmin();
      allow write: if false;

      match /entries/{entryId} {
        allow read: if (isSignedIn() && request.auth.uid == uid) || isPlatformAdmin();
        allow write: if false;
      }
    }
  }
}
