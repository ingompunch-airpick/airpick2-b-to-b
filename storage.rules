rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    /** Firestore rules `isPlatformAdmin()` 과 동일 */
    function isPlatformAdmin() {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email in [
          'drive5746@gmail.com',
          'ingompunch@gmail.com'
        ];
    }

    function isValidCompanyId(companyId) {
      return companyId.matches('^[a-z0-9_]{1,64}$');
    }

    function isValidReservationId(reservationId) {
      return reservationId.matches('^[a-zA-Z0-9_-]{1,128}$');
    }

    function partnerCompanyId() {
      return isSignedIn()
        && request.auth.token.partnerCompanyId is string
        && request.auth.token.partnerCompanyId.size() > 0
        ? request.auth.token.partnerCompanyId
        : '';
    }

    function isWawaCompanyId(cid) {
      return cid in ['wawa', 'wawa_valet'];
    }

    function partnerCanWriteCompanyFiles(companyId) {
      return partnerCompanyId().size() > 0
        && (
          partnerCompanyId() == companyId
          || (isWawaCompanyId(partnerCompanyId()) && isWawaCompanyId(companyId))
          || (
            firestore.exists(/databases/(default)/documents/companies/$(companyId))
            && firestore.get(/databases/(default)/documents/companies/$(companyId)).data.parentCompanyId
              == partnerCompanyId()
          )
        );
    }

    // 차량 사진: reservations/{companyId}/{reservationId}/images/…
    // 올리기·보기·지우기는 업체 직원(파트너 토큰)과 본사만. 손님(익명 로그인)은 불가.
    // 화면 표시는 다운로드 URL(토큰 포함)이라 이 규칙과 무관하게 계속 보인다.
    // 하위 업체·와와 별칭 예약도 올려야 해서 업체 일치까지는 보지 않는다.
    match /reservations/{companyId}/{reservationId}/{allPaths=**} {
      allow read: if isPlatformAdmin() || partnerCompanyId().size() > 0;
      allow create, update: if (isPlatformAdmin() || partnerCompanyId().size() > 0)
        && isValidCompanyId(companyId)
        && isValidReservationId(reservationId)
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isPlatformAdmin() || partnerCompanyId().size() > 0;
    }

    // 가맹점 주차장·보험·서류 사진. 본사 또는 해당 업체가 올린다. 읽기는 공개.
    match /companies/{companyId}/{allPaths=**} {
      allow read: if true;
      allow write: if isValidCompanyId(companyId)
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && (isPlatformAdmin() || partnerCanWriteCompanyFiles(companyId));
    }

    // 후기 사진: reviews/{reservationId}/… — 공개 읽기(B2C), 쓰기는 Admin SDK만
    match /reviews/{reservationId}/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // 파트너 홈페이지 미디어: partner-homepage/{companyId}/… (이미지·히어로 영상)
    // 쓰기는 본사만. 읽기는 공개(파트너 홈 표시).
    match /partner-homepage/{companyId}/{allPaths=**} {
      allow read: if true;
      allow write: if isPlatformAdmin()
        && isValidCompanyId(companyId)
        && request.resource.size < 100 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('video/.*')
        );
    }
  }
}
